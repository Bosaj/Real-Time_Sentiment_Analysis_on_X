  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "title": "Real-Time_Sentiment_Analysis_on_X - Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(app_requests_total[5m])",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Real-Time_Sentiment_Analysis_on_X - Request Duration (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(app_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 duration"
        }
      ]
    },
    {
      "id": 3,
      "title": "Real-Time_Sentiment_Analysis_on_X - Health & Evaluation Index",
      "type": "gauge",
      "targets": [
        {
          "expr": "model_evaluation_score{metric_name='quality_index'}",
          "legendFormat": "Quality Index"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rolling Sentiment Index (-1.0 Negative to +1.0 Positive)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sentiment_rolling_index{window='300s'}",
          "legendFormat": "Rolling Index (5m)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Sentiment Velocity (/min) & Polarity Spike Z-Score",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sentiment_velocity_per_min{window='300s'}",
          "legendFormat": "Velocity (/min)"
        },
        {
          "expr": "sentiment_polarity_spike_zscore{window='300s'}",
          "legendFormat": "Polarity Spike Z-Score"
        }
      ]
    },
    {
      "id": 6,
      "title": "Live Tweet Classification Throughput by Polarity",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (polarity) (rate(sentiment_predictions_total[5m]))",
          "legendFormat": "{{polarity}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "title": "Real-Time_Sentiment_Analysis_on_X Observability & Live Sentiment Telemetry Dashboard",
  "uid": "real_time_sentiment_analysis_on_x_obs",
